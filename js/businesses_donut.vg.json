{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "rgba(248, 250, 252, 0.9)",
  "title": "Businesses by State",
  "data": {
    "url": "data/businesses.csv"
  },
  "transform": [
    {
      "filter": "datum.State !== 'Australia'"
    },
    {
      "calculate": "replace(datum.Businesses, /[,\"]/g, '')",
      "as": "businesses_clean"
    },
    {
      "calculate": "parseFloat(datum.businesses_clean)",
      "as": "businesses_numeric"
    },
    {
      "filter": "isValid(datum.businesses_numeric) && isFinite(datum.businesses_numeric)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 50,
        "outerRadius": 150,
        "tooltip": true
      },
      "encoding": {
        "theta": {
          "field": "businesses_numeric",
          "type": "quantitative"
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {"range": ["#0072B2", "#56B4E9", "#D55E00", "#FF3B30", "#CC79A7", "#E69F00", "#F0E442", "#666666"]},
          "legend": null
        },
        "tooltip": [
          {"field": "State", "title": "State/Territory"},
          {"field": "businesses_numeric", "title": "Businesses", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 16,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {"value": "15,423"}
      }
    }
  ],
  "width": 300,
  "height": 300
}
